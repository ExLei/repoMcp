{
  "listen": ":8790",
  "token": "把这里换成一个长随机串，与 LangBot 侧 headers.Authorization 一致",
  "dataDir": "./data",
  "syncInterval": "15m",
  "gitTimeout": "3m",
  "maxResponseBytes": 12000,
  "githubToken": "有 issues 读写权限的 PAT；也可用环境变量 REPOMCP_GITHUB_TOKEN",
  "githubAttachmentSessionFile": "/opt/repomcp/secrets/github-attachment-session",
  "githubAttachmentAccount": "github-attachment-bot",
  "imageDownloadHosts": ["qpic.cn", "qq.com"],
  "imageDownloadAllowPrivate": false,
  "imageDownloadCookie": "",
  "mediaSourceDir": "/opt/astrbot/data/temp",
  "mediaSourcePrefix": "/AstrBot/data/temp",
  "mediaTimeout": "60s",
  "mediaTempDir": "./data/media-temp",
  "maxMediaUploadsPerHour": 20,
  "maxIssueCreatesPerHour": 5,
  "repos": [
    {
      "name": "example-source",
      "desc": "示例源码主仓：供模型检索源码并管理 issue",
      "url": "https://github.com/example-owner/example-source.git",
      "ref": "main",
      "webBase": "https://github.com/example-owner/example-source",
      "exclude": [
        "assets/i18n/*.json",
        "packages/**"
      ],
      "issues": {
        "write": true,
        "labels": [
          "bug",
          "enhancement",
          "question"
        ]
      }
    },
    {
      "name": "example-readonly",
      "desc": "示例只读仓：只开放源码与 issue 查询",
      "url": "https://github.com/example-owner/example-readonly.git",
      "ref": "main",
      "webBase": "https://github.com/example-owner/example-readonly",
      "issues": {}
    }
  ],
  "adminReporters": [
    "管理员昵称",
    "QQ号 xxxxxxx"
  ],
  "astrbotAdminsFile": "/AstrBot/data/cmd_config.json"
}